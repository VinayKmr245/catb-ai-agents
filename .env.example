# ── Provider selection ────────────────────────────────────────────────────────
# Pick one. Each provider reads its own token env var automatically.
# Options: copilot | copilot-enterprise | claude | gemini | openai | ollama
LLM_PROVIDER=copilot

# ── GitHub Copilot (Individual / Business) ────────────────────────────────────
# How to get: https://github.com/settings/tokens → select "copilot" scope
# Works with: Individual ($10/mo), Business ($19/user/mo)
# Data policy: prompts NOT used for training, 28-day retention
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
API_BASE_URL=https://models.inference.ai.azure.com
MODEL=gpt-4o

# ── GitHub Copilot Enterprise ─────────────────────────────────────────────────
# How to get: org admin generates SSO-authorized token at github.com/settings/tokens
# Works with: Enterprise ($39/user/mo)
# Data policy: ZERO retention, SOC2 Type II, HIPAA-eligible
# Uncomment and change LLM_PROVIDER=copilot-enterprise to use:
# GITHUB_TOKEN=ghp_org_xxxxxxxxxxxxxxxxxxxx
# API_BASE_URL=https://api.githubcopilot.com
# MODEL=gpt-4o

# ── Models available via Copilot subscription (no extra cost) ─────────────────
# GitHub Models gives access to these without a separate API subscription:
#   gpt-4o                  → best quality (default)
#   gpt-4o-mini             → faster, lower cost
#   o1-mini                 → reasoning model
#   meta-llama-3.1-405b-instruct
#   mistral-large-2407
#   phi-3.5-mini-instruct   → small, fast
# Full list: https://github.com/marketplace/models

# ── Anthropic Claude ──────────────────────────────────────────────────────────
# How to get:
#   1. Go to https://console.anthropic.com
#   2. Sign up / log in
#   3. Go to Settings → API Keys → Create Key
#   4. Copy the key (shown only once)
# Pricing: pay-per-token (no subscription required)
# Data policy: inputs not used for training by default
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# MODEL=claude-sonnet-4-5
# Available models: claude-opus-4-5 | claude-sonnet-4-5 | claude-haiku-4-5-20251001

# ── Google Gemini ─────────────────────────────────────────────────────────────
# How to get:
#   1. Go to https://aistudio.google.com/app/apikey
#   2. Sign in with Google account
#   3. Click "Create API key"
#   4. Copy the key
# Free tier: 15 requests/min on gemini-2.0-flash (no credit card needed)
# GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxx
# MODEL=gemini-2.0-flash
# Available models: gemini-2.0-flash | gemini-2.0-flash-lite | gemini-1.5-pro

# ── OpenAI directly ───────────────────────────────────────────────────────────
# How to get:
#   1. Go to https://platform.openai.com/api-keys
#   2. Sign in / create account
#   3. Click "+ Create new secret key"
#   4. Copy the key (shown only once)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# MODEL=gpt-4o

# ── Ollama (local — no API key, fully air-gapped) ─────────────────────────────
# How to set up:
#   1. Install: curl -fsSL https://ollama.com/install.sh | sh
#   2. Pull a model: ollama pull qwen2.5-coder:32b  (or :7b for lower-RAM machines)
#   3. Start server: ollama serve
# OLLAMA_TOKEN=ollama
# API_BASE_URL=http://localhost:11434/v1
# MODEL=qwen2.5-coder:32b

# ── Shared settings (apply to all providers) ──────────────────────────────────
MAX_TOKENS=4096
MAX_RETRIES=3
CYPRESS_ROOT=../
OUTPUT_DIR=cypress/e2e/generated
AUDIT_LOG=true
AUDIT_LOG_DIR=.audit-logs
